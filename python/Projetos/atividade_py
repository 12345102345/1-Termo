#Exercício - Crie uma aplicação que faça o cálculo de idade de pessoas.
# Deve perguntar o nome da pessoa e o ano de nascimento


import tkinter as tk
from tkinter import messagebox, ttk

janela = tk.Tk()
janela.title("Cálculo de Idade")
janela.geometry("1000x1000")
janela.configure(bg="pink")


def registro_pessoal():
     nome = ent_nome.get()
     ano_nascimento = ent_ano_nascimento.get()

     if nome == "":
         messagebox.showerror("Erro", "Por favor, insira seu nome.")
     elif ano_nascimento == "":
         messagebox.showerror("Erro", "Por favor, insira o ano de nascimento.")
     else:
         ano_nascimento = int(ano_nascimento)
         idade = 2026 - ano_nascimento
         messagebox.showinfo("Idade", f"{nome} tem {idade} anos.")

lbl_nome = tk.Label(janela,text="Nome:",font=("Arial", 12),bg="pink",fg="white")
lbl_nome.grid(row=0, column=0, padx=10, pady=10)

ent_nome = tk.Entry(janela,font=("Arial", 12),width=25)
ent_nome.grid(row=0, column=1, padx=10, pady=10)

lbl_ano_nascimento = tk.Label(janela,text="Ano de Nascimento:",font=("Arial", 12),bg="pink",fg="white")
lbl_ano_nascimento.grid(row=1, column=0, padx=10, pady=10)

ent_ano_nascimento = tk.Entry(janela,font=("Arial", 12),width=25)
ent_ano_nascimento.grid(row=1, column=1, padx=10, pady=10)

btn_registrar = tk.Button(janela,text="Registrar Pessoa",bg="black",fg="white",width=25,command=registro_pessoal)

btn_registrar = tk.Button(janela,text="Registrar Pessoa",bg="black",fg="white",width=25,command=registro_pessoal)
btn_registrar.grid(row=2, column=0, columnspan=2, pady=20)

